<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="441.0" prefWidth="615.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="CONTROLLER_NAME">
   <children>
      <Label layoutX="45.0" layoutY="37.0" text="Record Production Output:">
         <font>
            <Font size="24.0" />
         </font>
      </Label>
      <Label layoutX="45.0" layoutY="99.0" text="Select Production Batch:" />
      <ComboBox fx:id="selectProductionBatchComboBox" layoutX="189.0" layoutY="95.0" prefWidth="150.0" />
      <TableView fx:id="batchInfoTV" layoutX="45.0" layoutY="139.0" prefHeight="67.0" prefWidth="533.0">
        <columns>
          <TableColumn fx:id="batchIdTC" prefWidth="75.0" text="Batch ID" />
          <TableColumn fx:id="outputIdTC" prefWidth="75.0" text="Output ID" />
            <TableColumn fx:id="totalProducedTC" prefWidth="94.0" text="Total Produced" />
            <TableColumn fx:id="defectCountTC" prefWidth="94.0" text="Defect Count" />
            <TableColumn fx:id="usableCountTC" prefWidth="94.0" text="Usable Count" />
        </columns>
      </TableView>
      <Label layoutX="45.0" layoutY="234.0" text="Produced Quantity:" />
      <Label layoutX="45.0" layoutY="269.0" text="Defect Count:" />
      <Label layoutX="45.0" layoutY="310.0" text="Usable Count:" />
      <TextField fx:id="productQuantityTF" layoutX="158.0" layoutY="230.0" />
      <TextField fx:id="defectCountTF" layoutX="158.0" layoutY="265.0" />
      <TextField fx:id="usableCountTF" layoutX="158.0" layoutY="306.0" />
      <Button layoutX="70.0" layoutY="354.0" mnemonicParsing="false" onAction="#updateBatchOutputButtonOA" text="Update Batch Output" />
      <Button layoutX="389.0" layoutY="95.0" mnemonicParsing="false" onAction="#loadBatchInfoButtonOA" text="Load Batch Info" />
   </children>
</AnchorPane>
