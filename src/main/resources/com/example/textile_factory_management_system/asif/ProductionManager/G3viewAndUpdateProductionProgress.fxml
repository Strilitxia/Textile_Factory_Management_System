<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="449.0" prefWidth="667.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.textile_factory_management_system.asif.ProductionManager.Controller.ProdManG3Controller">
   <children>
      <Label layoutX="45.0" layoutY="44.0" text="View And Update Production Progress:">
         <font>
            <Font size="24.0" />
         </font>
      </Label>
      <Label layoutX="45.0" layoutY="107.0" text="Select Production Batch:" />
      <ComboBox fx:id="selectProductionBatchComboBox" layoutX="184.0" layoutY="103.0" prefWidth="150.0" />
      <TableView fx:id="productionBatchTV" layoutX="45.0" layoutY="136.0" prefHeight="82.0" prefWidth="608.0">
        <columns>
          <TableColumn fx:id="batchId" prefWidth="75.0" text="Batch ID" />
            <TableColumn fx:id="targetQuantityTC" prefWidth="93.0" text="Target Quantity" />
          <TableColumn fx:id="totalProducedTC" prefWidth="97.0" text="Total Produced" />
            <TableColumn fx:id="defectCountTC" prefWidth="97.0" text="Defect Count" />
            <TableColumn fx:id="usableCountTC" prefWidth="97.0" text="Usable Count" />
        </columns>
      </TableView>
      <Button layoutX="259.0" layoutY="240.0" mnemonicParsing="false" onAction="#loadBatchInfoButtonOA" text="Load Batch Info" />
   </children>
</AnchorPane>
