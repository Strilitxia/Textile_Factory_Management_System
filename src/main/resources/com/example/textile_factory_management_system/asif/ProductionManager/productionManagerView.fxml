<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!-- Background is near white: #fefefe -->

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="650.0" minWidth="900.0" prefHeight="650.0" prefWidth="900.0" style="-fx-background-color: #fefefe;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.textile_factory_management_system.asif.ProductionManager.Controller.ProductionViewController">

    <!-- TOP: Header/Welcome Area (Primary Dark Green: #1E4E43FF) -->
    <top>
        <VBox alignment="CENTER_LEFT" style="-fx-background-color: #3D1806; -fx-padding: 20px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 10, 0, 0, 5);" BorderPane.alignment="CENTER">
            <children>
                <Label text="Production Manager Dashboard" textFill="#fefefe">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>
                <!-- Welcome Label uses Bright Yellow/Green accent -->
                <Label fx:id="welcomeLabel" text="Welcome Message Placeholder" textFill="#F0F347">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
            </children>
        </VBox>
    </top>

    <!-- LEFT: Navigation Menu (Primary Dark Green: #1E4E43FF) -->
    <left>
        <VBox alignment="TOP_CENTER" prefHeight="560.0" prefWidth="263.0" spacing="15.0" style="-fx-background-color: #3D1806; -fx-padding: 20px;" BorderPane.alignment="CENTER">
            <children>

                <!-- Navigation Buttons (Bright Yellow/Green #F0F347 with Dark Green Text #1E4E43FF) -->
                <Button maxWidth="Infinity" onAction="#newProductionBatchButtonOA" style="-fx-background-color: #EBB591; -fx-text-fill: #4A2106; -fx-font-weight: bold; -fx-padding: 10px 15px; -fx-background-radius: 8px; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0, 0, 3); -fx-pref-height: 45px;" text="New Production Batch" />
                <Button maxWidth="Infinity" onAction="#viewTargetButtonOA" style="-fx-background-color: #EBB591; -fx-text-fill: #4A2106; -fx-font-weight: bold; -fx-padding: 10px 15px; -fx-background-radius: 8px; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0, 0, 3); -fx-pref-height: 45px;" text="MY Targets" />

                <Button maxWidth="Infinity" onAction="#viewProductionProgressButtonOA" style="-fx-background-color: #EBB591; -fx-text-fill: #4A2106; -fx-font-weight: bold; -fx-padding: 10px 15px; -fx-background-radius: 8px; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0, 0, 3); -fx-pref-height: 45px;" text="View Production Progress" />
                <Button maxWidth="Infinity" onAction="#assignTaskToWorkerButtonOA" style="-fx-background-color: #EBB591; -fx-text-fill: #4A2106; -fx-font-weight: bold; -fx-padding: 10px 15px; -fx-background-radius: 8px; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0, 0, 3); -fx-pref-height: 45px;" text="Assign Task to Worker" />
                <Button maxWidth="Infinity" onAction="#approveShiftChangeRequestButtonOA" style="-fx-background-color: #EBB591; -fx-text-fill: #4A2106; -fx-font-weight: bold; -fx-padding: 10px 15px; -fx-background-radius: 8px; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0, 0, 3); -fx-pref-height: 45px;" text="Approve Shift Change Request" />
                <Button maxWidth="Infinity" onAction="#recordProductionOutputButtonOA" style="-fx-background-color: #EBB591; -fx-text-fill: #4A2106; -fx-font-weight: bold; -fx-padding: 10px 15px; -fx-background-radius: 8px; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0, 0, 3); -fx-pref-height: 45px;" text="Record Production Output" />
                <Button maxWidth="Infinity" onAction="#assignShiftToWorkerButtonOA" style="-fx-background-color: #EBB591; -fx-text-fill: #4A2106; -fx-font-weight: bold; -fx-padding: 10px 15px; -fx-background-radius: 8px; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0, 0, 3); -fx-pref-height: 45px;" text="Assign Shift Schedule to Workers" />
                <Button maxWidth="Infinity" onAction="#requestRawMaterialButtonOA" style="-fx-background-color: #EBB591; -fx-text-fill: #4A2106; -fx-font-weight: bold; -fx-padding: 10px 15px; -fx-background-radius: 8px; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0, 0, 3); -fx-pref-height: 45px;" text="Request Raw Material" />
                <Label style="-fx-opacity: 0.7; -fx-font-size: 10px; -fx-text-fill: #fefefe;" text="Ver 1.0" />
            </children>
            <BorderPane.margin>
                <Insets right="5.0" />
            </BorderPane.margin>
        </VBox>
    </left>

    <!-- CENTER: Dynamic Content Area (Content background remains #fefefe) -->
    <center>
        <VBox fx:id="contentContainer" alignment="TOP_CENTER" spacing="10.0" style="-fx-padding: 20px;">
            <!-- Text uses the Primary Dark Color -->
            <Label style="-fx-font-size: 18px; -fx-opacity: 0.7; -fx-padding: 50px; -fx-text-fill: #1E4E43FF;" text="Select a navigation item to view content." />
        </VBox>
    </center>
</BorderPane>
